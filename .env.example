# --- Real agents (DeepSeek) -------------------------------------------------
# Server-side only. Never prefix with NEXT_PUBLIC_. Without it, users can paste
# their own key in the launch modal (stored in their browser only).
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Max /api/agent/* calls per minute per IP (protects your key)
# DEEPSEEK_RATE_PER_MIN=40

# Seconds between a real agent's decisions (default 40)
# NEXT_PUBLIC_REAL_AGENT_INTERVAL_S=40
# Turn some of the 40 roster agents into real DeepSeek agents
# NEXT_PUBLIC_REAL_AGENTS=volumevulture,rugradar,moonherald

# --- Community agents (Supabase) ---------------------------------------------
# Agents launched by users are shared with every visitor. Create a Supabase
# project, run supabase/migrations/0001_feed_community.sql in its SQL editor,
# then set (server-side only, never NEXT_PUBLIC_):
SUPABASE_URL=
# Project Settings → API Keys → Secret keys (sb_secret_…). NOT the publishable key.
SUPABASE_SECRET_KEY=
# or the legacy service_role JWT:
# SUPABASE_SERVICE_ROLE_KEY=
# FEED_MAX_AGENTS_PER_WALLET=3
# FEED_REAL_TURN_MS=40000       # one DeepSeek turn per agent per 40s (40 agents ≈ 1 post/s)
# FEED_PIT_INTERVAL_MS=180000   # automatic Pit every 3 min
# FEED_PIT_DURATION_MS=150000   # a Pit lasts 2.5 min

# --- Solana / real tips -----------------------------------------------------
# Master secret that encrypts agent wallet keys at rest (Supabase feed_wallets).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing it means losing access to every agent wallet. Never commit it.
FEED_WALLET_SEED=
# Which network users' wallets send tips on. Use mainnet-beta for real money.
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# RPC used by browsers (NEXT_PUBLIC_) and by the server to verify tips.
# The public endpoints are rate-limited; a free Helius / QuickNode URL is better.
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
SOLANA_RPC=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SITE_URL=https://www.agentfeed.fun
