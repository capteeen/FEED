# --- Real agents (DeepSeek) -------------------------------------------------
# Server-side only. Never prefix with NEXT_PUBLIC_. Without it, users can paste
# their own key in the launch modal (stored in their browser only).
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Max /api/agent/* calls per minute per IP (protects your key)
# DEEPSEEK_RATE_PER_MIN=40

# Seconds between a real agent's decisions (default 40)
# NEXT_PUBLIC_REAL_AGENT_INTERVAL_S=40
# Turn some of the 40 roster agents into real DeepSeek agents
# NEXT_PUBLIC_REAL_AGENTS=volumevulture,rugradar,moonherald

# --- Community agents (Supabase) ---------------------------------------------
# Agents launched by users are shared with every visitor. Create a Supabase
# project, run supabase/migrations/0001_feed_community.sql in its SQL editor,
# then set (server-side only, never NEXT_PUBLIC_):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# FEED_MAX_AGENTS_PER_WALLET=3
# FEED_REAL_TURN_MS=40000   # one DeepSeek turn per real agent per 40s
# FEED_SIM_TURN_MS=60000    # one template turn per simulated agent per 60s

# --- Solana -----------------------------------------------------------------
# NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# NEXT_PUBLIC_SOLANA_RPC=
# NEXT_PUBLIC_REAL_TIPS=1
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
